binds {
    //================================================KEYBINDINGS================================================
    // General actions.
    Mod+Tab repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Functions keys.
    Print { screenshot; }
    Mod+Shift+S { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Windows focus.
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    // Move column.
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    // Fast column.
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    // Column consumption and expulsion.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Consume and expel.
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Size adjustments presets.
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    // Size adjustments custom.
    Mod+Alt+Left { set-column-width "-10%"; }
    Mod+Alt+Right { set-column-width "+10%"; }
    Mod+Alt+Up { set-window-height "-10%"; }
    Mod+Alt+Down { set-window-height "+10%"; }

    // Workspace.
    Mod+Ctrl+Down     { focus-workspace-down; }
    Mod+Ctrl+Up       { focus-workspace-up; }
    Mod+Ctrl+Right { move-column-to-workspace-down; }
    Mod+Ctrl+Left   { move-column-to-workspace-up; }

    // Fast workspace switching and moving.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    //================================================APPS-LAUNCHER================================================
    Mod+T hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Mod+Shift+T hotkey-overlay-title="Open a Popup-Terminal: kitty" { spawn "kitty" "--class" "kitty-popup"; }
    Mod+Z hotkey-overlay-title="Run an Application: zed" { spawn "zeditor"; }
    Mod+B hotkey-overlay-title="Run an Application: brave" { spawn "brave-origin-nightly" "--ozone-platform=wayland"; }
    Mod+Shift+D hotkey-overlay-title="Run an Application: nautilus" { spawn "nautilus"; }
    Mod+D hotkey-overlay-title="Run an Application: Yazi" { spawn "kitty" "yazi"; }



    //================================================EQUIBOP================================================
    Mod+MouseForward { spawn "equibop" "--toggle-mic"; }

    //================================================MOUSE-BINDINGS================================================
    // Workspace mouse.
    Mod+Shift+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // Column mouse.
    Mod+WheelScrollDown      { focus-column-right; }
    Mod+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    //================================================SazV-SHELL================================================
    // ----------Launcher Functions----------
    Mod+A hotkey-overlay-title="Run an Application: Launcher" { spawn-sh "pkill -U $USER rofi || rofi -show drun"; }
    Mod+Shift+W hotkey-overlay-title="Run the Wallpaper Selector" { spawn-sh "pkill -U $USER waypaper || waypaper"; }

    // ----------System Functions----------
    // Audio Management
    XF86AudioRaiseVolume allow-when-locked=true { spawn "~/.config/swaync/scripts/notify-control.sh" "volume" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "~/.config/swaync/scripts/notify-control.sh" "volume" "down"; }
    XF86AudioMute        allow-when-locked=true { spawn "~/.config/swaync/scripts/notify-control.sh" "volume" "mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "~/.config/swaync/scripts/notify-control.sh" "mic" "mute"; }

    // // Media Controls
    // XF86AudioPlay        allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "playPause"; }
    // XF86AudioStop        allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "pause"; }
    // XF86AudioPrev        allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "previous"; }
    // XF86AudioNext        allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "next"; }

    // Display & Brightness
    XF86MonBrightnessUp allow-when-locked=true { spawn "~/.config/swaync/scripts/notify-control.sh" "brightness" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "~/.config/swaync/scripts/notify-control.sh" "brightness" "down"; }

    //================================================NOCTALIA-SHELL================================================
    // Menu + Launcher
    Mod+Alt+L hotkey-overlay-title="Lock the Screen menu" { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "sessionMenu" "toggle"; }
    //Mod+A hotkey-overlay-title="Run the Launcher" { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    //Mod+Shift+W hotkey-overlay-title="Run the Wallpaper Selector" { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "wallpaper" "toggle"; }

    // Audio Management
    // XF86AudioRaiseVolume allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "increase"; }
    // XF86AudioLowerVolume allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "decrease"; }
    // XF86AudioMute        allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "muteOutput"; }
    // XF86AudioMicMute     allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "muteInput"; }

    // Media Controls
    //XF86AudioPlay        allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "playPause"; }
    //XF86AudioStop        allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "pause"; }
    //XF86AudioPrev        allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "previous"; }
    //XF86AudioNext        allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "next"; }

    // Display & Brightness
    //XF86MonBrightnessUp allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "brightness" "increase"; }
    //XF86MonBrightnessDown allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "brightness" "decrease"; }
}
