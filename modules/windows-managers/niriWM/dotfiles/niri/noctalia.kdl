layout {

    focus-ring {
        active-color   "#faacf9"
        inactive-color "#1e100f"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#faacf9"
        inactive-color "#1e100f"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#faacf9"
        inactive-color "#6c2d70"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#faacf980"
    }
}

recent-windows {
    highlight {
        active-color "#faacf9"
        urgent-color "#ffb4ab"
    }
}
