layout {

    focus-ring {
        active-color   "#fcbb4a"
        inactive-color "#111509"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#fcbb4a"
        inactive-color "#111509"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#fcbb4a"
        inactive-color "#604100"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#fcbb4a80"
    }
}

recent-windows {
    highlight {
        active-color "#fcbb4a"
        urgent-color "#ffb4ab"
    }
}
