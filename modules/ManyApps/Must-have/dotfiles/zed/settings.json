{
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "diagnostics": {
    "button": true
  },
  "status_bar": {
    "show_active_file": true,
    "cursor_position_button": true,
    "active_language_button": true
  },
  "project_panel": {
    "dock": "left",
    "button": true
  },
  "prettier": {
    "allowed": true
  },
  "buffer_line_height": "standard",
  "ui_font_family": "Maple Mono NF CN",
  "buffer_font_family": "Maple Mono NF CN",
  "icon_theme": "Catppuccin Mocha",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Noctalia Dark Transparent",
  },
  "remove_trailing_whitespace_on_save": true,
  "edit_predictions": {
    "mode": "eager",
    "provider": "copilot",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": false,
  "terminal": {
    "button": true,
    "cursor_shape": "bar",
    "font_size": 14.0,
    "shell": {
      "program": "fish",
    },
  },
  "autosave": "off",
  "base_keymap": "VSCode",
  "format_on_save": "off",
  "formatter": "auto",
}
